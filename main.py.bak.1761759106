@app.post("/api/listing")
async def create_pool(payload: Dict[str, Any]):
    """
    Плейсхолдер под Raydium pool — возвращает пустую валидную транзу с blockhash.
    Ожидает: wallet, mint_address, decimals, sol_amount, token_amount.
    """
    try:
        wallet = payload.get("wallet")
        mint_address = payload.get("mint_address")
        decimals = int(payload.get("decimals", 9))
        sol_amount = float(payload.get("sol_amount", 0))
        token_amount = float(payload.get("token_amount", 0))
        priority_fee = int(payload.get("priority_fee", 250000))
        use_token_2022 = bool(payload.get("use_token_2022", True))

        if not wallet or not mint_address:
            raise HTTPException(status_code=400, detail="wallet and mint_address are required")

        res = await create_pool_transaction(
            connection=connection,
            wallet=wallet,
            mint_address=mint_address,
            decimals=decimals,
            sol_amount=sol_amount,
            token_amount=token_amount,
            priority_fee=priority_fee,
            use_token_2022=use_token_2022,
        )
        if not res.get("success"):
            raise HTTPException(status_code=500, detail=res.get("message", "create pool failed"))

        tx = res["transaction"]
        return {
            "success": True,
            "transaction": _b64(tx),
            "pool_id": res.get("pool_id"),
            "lp_mint": res.get("lp_mint"),
        }

    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error creating pool: {e}")
