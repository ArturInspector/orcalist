server {
    listen 80;
    server_name _;  # или твой домен

    # Если фронт собран и лежит в папке проекта — отдаём как SPA:
    root /root/soltokenmint/soltoken-frontend;
    index index.html;

    # API → на uvicorn:8000
    location /api/ {
        proxy_pass         http://127.0.0.1:8000/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_read_timeout 60s;
    }

    # SPA-роутинг — все несуществующие файлы пробрасываем на index.html
    location / {
        try_files $uri /index.html;
    }

    # на всякий — ограничение тела запроса
    client_max_body_size 20m;
}
